# DevOps LLM Agent Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql://devops:devops@localhost:5432/devops_agent
REDIS_URL=redis://localhost:6379

# LLM Providers
# Note: You can also configure API keys through the web UI (Settings -> LLM Providers -> Configure button)
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Environment Profiles
ENVIRONMENT_PROFILES_DIR=environments
ENVIRONMENT_CACHE_TTL=300
ENABLE_GEMINI_PROVIDER=false
ENABLE_OLLAMA_PROVIDER=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Observability
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Security Policies
SECURITY_ENABLED=true
SECURITY_STRICT_MODE=false
AUDIT_LOGGING=true

# Monitoring
HEALTH_CHECK_INTERVAL=30
SYSTEM_MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=60

